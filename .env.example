# Which data implementation the UI talks to.
#   mock   – each browser keeps its own data in IndexedDB (default)
#   remote – the shared backend: Postgres behind /api (needs DATABASE_URL)
NEXT_PUBLIC_DATA_SOURCE=mock

# Postgres for the remote backend. On Vercel, the Neon integration sets this.
# Never commit a real one; put it in .env.local.
# DATABASE_URL=postgres://user:password@localhost:5432/kiosk

# Canonical site URL for metadata, OG images and the sitemap.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# NEXT_PUBLIC_SITE_URL=https://kiosk.example

# Upper bound (ms) for simulated latency in the mock layer. 0 disables it.
# NEXT_PUBLIC_MOCK_LATENCY=900
