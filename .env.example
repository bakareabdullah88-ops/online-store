# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.
# Don't set NODE_ENV: Next.js and Vercel set it themselves.

# --- Database (Neon) -------------------------------------------------------
# With this set, the shared backend switches on by itself. Without it, each
# browser keeps its own data (handy for quick local work).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Google sign-in (Better Auth) ------------------------------------------
# In Google Cloud → Credentials, the OAuth client's "Authorized redirect URI"
# must be  <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# A long random string: `openssl rand -base64 32`
# BETTER_AUTH_SECRET=
# The site's address, e.g. https://kamplug.com (http://localhost:3000 locally)
# BETTER_AUTH_URL=
# NEXT_PUBLIC_APP_URL=

# --- Photo uploads (Cloudflare R2) -----------------------------------------
# Without these, photos are stored in the database instead.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=kamplug-images
# The bucket's public address (r2.dev or a custom domain), no trailing slash
# R2_PUBLIC_URL=

# --- Optional --------------------------------------------------------------
# Force a data source: mock (each browser on its own) or remote (the backend).
# Defaults to remote when DATABASE_URL is set.
# NEXT_PUBLIC_DATA_SOURCE=
# Simulated latency ceiling (ms) in mock mode. 0 disables it.
# NEXT_PUBLIC_MOCK_LATENCY=900
